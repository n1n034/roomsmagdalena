rules_version = '2';

// Pristup imaju samo prijavljeni korisnici čiji UID postoji u kolekciji "admins".
// Admine dodaje skripta s Admin SDK-om (ili ručno u Firebase konzoli) – iz preglednika se ne mogu dodati.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isValidReservation(d) {
      return d.keys().hasOnly(['unitId', 'firstName', 'lastName', 'phone', 'adults', 'children',
                               'arrival', 'departure', 'status', 'note', 'createdAt', 'updatedAt'])
        && d.unitId in ['s1', 's2', 's3', 's4', 's5', 's6', 's7', 'a1', 'a2']
        && isShortString(d.firstName, 100)
        && isShortString(d.lastName, 100) && d.lastName.size() > 0
        && isShortString(d.phone, 40)
        && d.adults is int && d.adults >= 0 && d.adults <= 20
        && d.children is int && d.children >= 0 && d.children <= 20
        && isDate(d.arrival) && isDate(d.departure) && d.departure > d.arrival
        && d.status in ['placeno', 'akontacija', 'nije_placeno']
        && isShortString(d.note, 500)
        && d.updatedAt is timestamp;
    }

    // Admin smije pročitati samo vlastiti zapis (da stranica zna ima li pristup)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /reservations/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidReservation(request.resource.data);
    }

    // Sve ostalo je zabranjeno
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
